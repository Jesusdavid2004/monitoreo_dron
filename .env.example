# ============================================================
# Drone Monitoring Platform - Environment configuration
# ============================================================
# Copy this file to `.env` and adjust the values for your
# local development environment.

# --- Application ---
NODE_ENV=development
# Public base URL used for metadata and links (update on deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Used by Prisma ORM. Local example:
# postgresql://postgres:postgres@localhost:5432/drone_monitoring?schema=public
# For Railway / Render, replace with the provided DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drone_monitoring?schema=public"

# --- Logging ---
# Allowed values: debug | info | warn | error
LOG_LEVEL=info

# --- ISR revalidation (seconds) ---
MISSIONS_REVALIDATE=60

# --- API request timeout (milliseconds) ---
API_TIMEOUT_MS=5000